{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "akey run 交互时序",
    "locale": "zh-CN",
    "output": "akey-run-sequence.html",
    "viewBox": [
      1040,
      620
    ],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {
      "id": "agent",
      "type": "external",
      "label": "Agent / 调用方",
      "sublabel": "AI agent 或人类"
    },
    {
      "id": "cli",
      "type": "backend",
      "label": "akey CLI",
      "sublabel": "run 子命令"
    },
    {
      "id": "store",
      "type": "backend",
      "label": "Vault Store",
      "sublabel": "鉴权 → 解密"
    },
    {
      "id": "masker",
      "type": "security",
      "label": "输出遮蔽器",
      "sublabel": "跨块匹配 · 保留窗口"
    },
    {
      "id": "child",
      "type": "external",
      "label": "子进程",
      "sublabel": "明文只到这里"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 258,
      "label": "解析与鉴权"
    },
    {
      "from": 268,
      "to": 386,
      "label": "解密与注入"
    },
    {
      "from": 396,
      "to": 524,
      "label": "输出遮蔽与退出"
    }
  ],
  "messages": [
    {
      "id": "run",
      "from": "agent",
      "to": "cli",
      "y": 160,
      "label": "akey run --with KEY=akey://openai/credential -- …",
      "variant": "emphasis"
    },
    {
      "id": "resolve-authorize",
      "from": "cli",
      "to": "store",
      "y": 190,
      "label": "解析引用 · 鉴权早于解密",
      "variant": "security"
    },
    {
      "id": "allowed",
      "from": "store",
      "to": "cli",
      "y": 218,
      "label": "允许（令牌作用域 · reveal 策略）",
      "variant": "return"
    },
    {
      "id": "decrypt",
      "from": "cli",
      "to": "store",
      "y": 248,
      "label": "解密 vault.age",
      "variant": "security"
    },
    {
      "id": "plaintext",
      "from": "store",
      "to": "cli",
      "y": 278,
      "label": "明文字段值",
      "variant": "return"
    },
    {
      "id": "register",
      "from": "cli",
      "to": "masker",
      "y": 310,
      "label": "登记明文（用于遮蔽）",
      "variant": "security"
    },
    {
      "id": "spawn",
      "from": "cli",
      "to": "child",
      "y": 340,
      "label": "注入环境变量 · 明文只到这里",
      "variant": "emphasis"
    },
    {
      "id": "stream",
      "from": "child",
      "to": "cli",
      "y": 370,
      "label": "stdout / stderr",
      "variant": "default"
    },
    {
      "id": "feed",
      "from": "cli",
      "to": "masker",
      "y": 400,
      "label": "逐块 Feed",
      "variant": "dashed"
    },
    {
      "id": "masked",
      "from": "masker",
      "to": "cli",
      "y": 428,
      "label": "替换后的块",
      "variant": "return"
    },
    {
      "id": "concealed",
      "from": "cli",
      "to": "agent",
      "y": 458,
      "label": "遮蔽后的输出：<concealed by akey>",
      "variant": "emphasis"
    },
    {
      "id": "exit-code",
      "from": "child",
      "to": "cli",
      "y": 488,
      "label": "退出码 42",
      "variant": "return"
    },
    {
      "id": "passthrough",
      "from": "cli",
      "to": "agent",
      "y": 516,
      "label": "原样透传退出码",
      "variant": "emphasis"
    }
  ],
  "activations": [
    {
      "participant": "cli",
      "from": 160,
      "to": 524,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 186,
      "to": 292,
      "type": "backend"
    },
    {
      "participant": "masker",
      "from": 306,
      "to": 434,
      "type": "security"
    },
    {
      "participant": "child",
      "from": 336,
      "to": 494,
      "type": "external"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "明文只离开一次",
      "items": [
        "明文只写进子进程的环境变量，不写调用者的 stdout",
        "调用者拿到的是遮蔽后的输出",
        "遮蔽器跨读取块匹配，保留窗口足够长才下结论"
      ]
    },
    {
      "dot": "rose",
      "title": "鉴权早于解密",
      "items": [
        "令牌作用域与 reveal 策略在解密之前判定",
        "越权的引用因此根本不会产生明文",
        "受限令牌下 run --with 越权条目 → 退出 8"
      ]
    },
    {
      "dot": "cyan",
      "title": "退出码是契约",
      "items": [
        "run 是透明包装：子进程退 42，akey 也退 42",
        "被信号杀死折算成 128 + signal（unix）",
        "调用方的错误处理依赖这一点"
      ]
    }
  ]
}
