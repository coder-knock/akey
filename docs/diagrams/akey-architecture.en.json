      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "config-to-store",
      "from": "config",
      "to": "store",
      "label": "trusted ∩ recipients",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "store-to-recipients",
      "from": "store",
      "to": "recipients",
      "label": "read / write the directory",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24,
      "labelDx": -64
    },
    {
      "id": "store-to-vault",
      "from": "store",
      "to": "vault",
      "label": "read / write age ciphertext",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "vault-to-remote",
      "from": "vault",
      "to": "remote",
      "label": "pull / push ciphertext",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "child-to-masker",
      "from": "child",
      "to": "masker",
      "label": "stdout / stderr",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "masker-to-agent",
      "from": "masker",
      "to": "agent",
      "label": "masked output",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Plaintext reaches only the child",
      "items": [
        "run injects plaintext into the child's environment only",
        "the caller receives masked output",
        "the masker matches across read chunks, holding back until the window is long enough"
      ]
    },
    {
      "dot": "emerald",
      "title": "The access decision stays local",
      "items": [
        "recipients.json says who exists, and arrives via an untrusted remote",
        "encryption targets recipients ∩ config.trusted",
        "a key pushed into the directory receives nothing until a human approves it"
      ]
    },
    {
      "dot": "rose",
      "title": "Encryption at rest, and its cost",
      "items": [
        "age: X25519 + ChaCha20-Poly1305, no KDF on the hot path",
        "scrypt runs only at init and recovery",
        "each device holds its own key, and it cannot enter git"
      ]
    }
  ]
}
