        "audit",
        "identity",
        "config"
      ]
    },
    {
      "kind": "region",
      "label": "金库仓库 repo/（只有密文离开本机）",
      "wraps": [
        "recipients",
        "vault"
      ]
    }
  ],
  "connections": [
    {
      "id": "agent-to-cli",
      "from": "agent",
      "to": "cli",
      "label": "akey run --with KEY=akey://…",
