    },
    {
      "id": "cli-to-store",
      "from": "cli",
      "to": "store",
      "label": "解析引用 · 鉴权早于解密"
    },
    {
      "id": "store-to-child",
      "from": "store",
      "to": "child",
      "label": "注入明文环境变量",
      "variant": "emphasis"
    },
    {
      "id": "cli-to-audit",
      "from": "cli",
      "to": "audit",
      "label": "无值留痕",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "identity-to-store",
      "from": "identity",
      "to": "store",
      "label": "本机私钥解密",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "config-to-store",
      "from": "config",
      "to": "store",
      "label": "trusted ∩ 收件人",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "store-to-recipients",
      "from": "store",
      "to": "recipients",
      "label": "读 / 写目录",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24,
      "labelDx": -44
    },
    {
      "id": "store-to-vault",
      "from": "store",
      "to": "vault",
      "label": "读 / 写 age 密文",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "vault-to-remote",
      "from": "vault",
      "to": "remote",
      "label": "pull / push 密文",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "child-to-masker",
      "from": "child",
      "to": "masker",
      "label": "stdout / stderr",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "masker-to-agent",
      "from": "masker",
      "to": "agent",
      "label": "遮蔽后的输出",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "明文只到子进程",
      "items": [
        "run 把明文注入子进程的环境变量，仅它可见",
        "调用者拿到的是遮蔽后的输出",
        "遮蔽器跨读取块匹配，保留窗口足够长才下结论"
      ]
    },
    {
      "dot": "emerald",
      "title": "访问决策留在本机",
      "items": [
        "recipients.json 只说「谁存在」，且由不可信远端分发",
        "加密对象是 recipients ∩ config.trusted",
        "远端塞进的公钥在获本地批准前拿不到任何密文"
      ]
    },
    {
      "dot": "rose",
      "title": "静态加密与成本",
      "items": [
        "age：X25519 + ChaCha20-Poly1305，热路径上无 KDF",
        "scrypt 只在 init 与 recovery 时跑",
        "每台设备一把自己的私钥，进不了 git"
      ]
    }
  ]
}
