  "activations": [
    {
      "participant": "cli",
      "from": 160,
      "to": 524,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 186,
      "to": 292,
      "type": "backend"
    },
    {
      "participant": "masker",
      "from": 306,
      "to": 434,
